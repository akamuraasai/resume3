#!/bin/sh

# Skip if the last commit was already a PDF regeneration (avoid loop)
last_msg=$(git log -1 --format=%s)
if [ "$last_msg" = "chore: regenerate resume PDFs" ]; then
  exit 0
fi

# Establish diff range against upstream
remote_ref=$(git rev-parse @{u} 2>/dev/null)
if [ -z "$remote_ref" ]; then
  diff_range="HEAD"
else
  diff_range="$remote_ref..HEAD"
fi

# Detect "fundamental" changes that affect rendering output across the board.
# Any change in these paths means we regenerate every PDF.
fundamental_changed=$(git diff --name-only --diff-filter=ACMR $diff_range -- \
  'src/components/' \
  'src/lib/' \
  'src/index.ts' \
  'tests/pdf/' \
  'playwright.config.ts' \
  'package.json' \
  'bun.lock' \
  'tsconfig.json')

# Detect resume markdown changes (per-PDF regen target)
md_changed=$(git diff --name-only --diff-filter=ACMR $diff_range -- 'resumes/**/*.md')

if [ -z "$fundamental_changed" ] && [ -z "$md_changed" ]; then
  exit 0
fi

if [ -n "$fundamental_changed" ]; then
  echo "📄 Fundamental change detected — regenerating ALL PDFs..."
  bun run pdf
else
  # Build a Playwright --grep pattern from the changed markdown files.
  # resumes/tech/en.md -> tech/en
  # Multiple paths joined with | for regex alternation.
  pattern=$(echo "$md_changed" | sed -e 's|^resumes/||' -e 's|\.md$||' | paste -sd '|' -)
  echo "📄 Resume markdown changed — regenerating PDFs for: $pattern"
  bun run pdf -- --grep="generate PDF for ($pattern)"
fi

# Check if PDFs actually changed
pdf_changed=$(git diff --name-only -- 'resumes/**/*.pdf')
if [ -z "$pdf_changed" ]; then
  echo "✓ PDFs are already up to date."
  exit 0
fi

# PDFs are stale — commit and abort push
echo "📝 Committing updated PDFs..."
git add resumes/**/*.pdf
git commit -m "chore: regenerate resume PDFs"

echo ""
echo "⚠ PDFs were regenerated and committed. Please push again."
exit 1
